# ============================================================
# PORTFOLIO BACKEND ENVIRONMENT VARIABLES (Vercel & TiDB Cloud)
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# TiDB Cloud Starter / MySQL Database Configuration
# Copy connection details from TiDB Cloud Console -> Connect -> Node.js / General
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_prefix.root
DB_PASSWORD=your_tidb_password_here
DB_NAME=portfolio_db
# Set DB_SSL=true for TiDB Cloud (TLS 1.2+ encrypted connection)
DB_SSL=true
DB_CONNECTION_LIMIT=5

# Admin Security & Credentials
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_production_jwt_secret_here
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_production_admin_password

# CORS Configuration (optional - Vercel same-origin is handled automatically)
ALLOWED_ORIGINS=https://ishagiri.github.io,http://localhost:3000
