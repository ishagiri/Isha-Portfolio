# ============================================================
# PORTFOLIO BACKEND ENVIRONMENT VARIABLES
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=portfolio_db
# Set DB_SSL=true when connecting to Cloud MySQL (e.g., TiDB Cloud, Aiven, Railway)
DB_SSL=false
DB_CONNECTION_LIMIT=5

# Admin Security & Credentials
JWT_SECRET=your_production_jwt_secret_here
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

# CORS Allowed Origins (comma-separated for cross-origin setups)
ALLOWED_ORIGINS=https://ishagiri.github.io,http://localhost:3000

